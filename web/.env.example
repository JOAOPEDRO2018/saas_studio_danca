# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# no Supabase (Project Settings > API Keys / Data API).
# O .env.local não vai para o git.

# Endereço do projeto: https://<id-do-projeto>.supabase.co (sem /rest/v1 no final)
SUPABASE_URL=

# Chave publicável (começa com sb_publishable_). Usada no login; o acesso aos
# dados segue as regras do RLS (supabase/03-login.sql).
SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (começa com sb_secret_). Ignora o RLS; reservada para as rotinas
# automáticas. Nunca compartilhe.
SUPABASE_SECRET_KEY=
