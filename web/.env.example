# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# no Supabase (Project Settings > API Keys / Data API).
# O .env.local não vai para o git.

# Endereço do projeto: https://<id-do-projeto>.supabase.co
SUPABASE_URL=

# Chave secreta (começa com sb_secret_). Só o servidor usa; nunca compartilhe.
SUPABASE_SECRET_KEY=
